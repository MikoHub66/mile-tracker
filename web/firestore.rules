rules_version = '2';
// Everything lives under users/{uid}/ and only that signed-in user can read or
// write it: trips/, vehicles/, settings/automation. The phone's background
// uploader writes over REST with the same user's ID token, so it obeys these too.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
